# Augurio providers
# FreeLLMAPI local/self-hosted gateway (optional)
FREELLMAPI_BASE_URL=http://localhost:3001
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto:smart

# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# xAI
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Supabase
SUPABASE_URL=
# Prefer a server-only secret key for Augurio memory writes.
SUPABASE_SECRET_KEY=
# Legacy server key supported as fallback.
SUPABASE_SERVICE_ROLE_KEY=
# Publishable key is supported but should only be used with appropriate RLS policies.
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional GitHub integration
GITHUB_TOKEN=
